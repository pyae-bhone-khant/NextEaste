generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Property {
  id           String  @id @default(cuid())
  title        String
  description  String?
  propertyType String
  listingType  String
  price        Int
  bedrooms     Int
  bathrooms    Int
  parkingSpace Int
  area         Int
  location     String
  address      String
  image        String
  type         String
  status       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  // owner User @relation(fields: [ownerId], references: [id] , onDelete: Cascade)
}
